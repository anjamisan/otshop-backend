<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="users_purchases_report"
              pageWidth="595" pageHeight="842"
              columnWidth="535"
              leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="generatedOn" class="java.util.Date"/>

    <field name="username" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="purchaseCount" class="java.lang.Integer"/>
    <field name="lastPurchaseDate" class="java.util.Date"/>
    <field name="totalSpent" class="java.lang.Integer"/>

    
    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="535" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="30" width="535" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on: " + new java.text.SimpleDateFormat("dd.MM.yyyy HH:mm").format($P{generatedOn})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    
    <columnHeader>
        <band height="25">
            <!-- Shaded background for header -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="25" backcolor="#E0E0E0" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="0" y="0" width="100" height="25"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Username]]></text>
            </staticText>

            <staticText>
                <reportElement x="100" y="0" width="150" height="25"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Email]]></text>
            </staticText>

            <staticText>
                <reportElement x="250" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Purchases]]></text>
            </staticText>

            <staticText>
                <reportElement x="330" y="0" width="100" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Last Purchase]]></text>
            </staticText>

            <staticText>
                <reportElement x="430" y="0" width="105" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total Spent (RSD)]]></text>
            </staticText>
        </band>
    </columnHeader>

    
    <detail>
        <band height="20">
            <!-- Light row background for readability -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20" backcolor="#F9F9F9" mode="Opaque"/>
            </rectangle>

            <textField>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{username}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="100" y="0" width="150" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="250" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{purchaseCount}]]></textFieldExpression>
            </textField>

            <textField pattern="dd.MM.yyyy">
                <reportElement x="330" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{lastPurchaseDate}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0 RSD">
                <reportElement x="430" y="0" width="105" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{totalSpent}]]></textFieldExpression>
            </textField>

            <!-- Optional: line separator -->
            <line>
                <reportElement x="0" y="19" width="535" height="1" forecolor="#CCCCCC"/>
            </line>
        </band>
    </detail>

    
    <pageFooter>
        <band height="20">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#CCCCCC"/>
            </line>
            <textField>
                <reportElement x="0" y="5" width="535" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
